# Copie este arquivo para .env antes de executar o docker compose.
# Os valores abaixo servem apenas para o ambiente local de desenvolvimento.

POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina_local
POSTGRES_PORT=5432

APP_PORT=8080

# Interface web do servidor de e-mail local, onde aparecem os orçamentos enviados.
MAILPIT_UI_PORT=8025

# Usuário administrativo de demonstração, criado na primeira inicialização.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
