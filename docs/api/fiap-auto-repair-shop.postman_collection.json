{
  "info": {
    "name": "Oficina Mecânica - API (FIAP SOAT Fase 1)",
    "description": "Fluxo completo da ordem de serviço, do login à entrega, com testes em cada requisição. As variáveis são preenchidas durante a execução. Para rodar pela linha de comando: npx newman run docs/api/fiap-auto-repair-shop.postman_collection.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Autenticação",
      "description": "Login do usuário administrativo. O token fica na variável token e é usado nas rotas /api/admin.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('token Bearer com validade', () => {",
                  "    pm.expect(body.tokenType).to.eql('Bearer');",
                  "    pm.expect(body.expiresIn).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set('token', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Rota administrativa sem token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/customers",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('desafio Bearer', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Cadastros",
      "description": "Cliente, veículo, serviço, peça e entrada de estoque usados pela ordem de serviço.",
      "item": [
        {
          "name": "Cadastrar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"{{customerDocument}}\",\n  \"name\": \"Maria Silva\",\n  \"email\": \"{{customerEmail}}\",\n  \"phone\": \"11999990000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera CPF e placa válidos a cada execução, para a coleção rodar várias vezes no mesmo banco.",
                  "function digit(numbers) {",
                  "    let sum = 0;",
                  "    for (let i = 0; i < numbers.length; i++) {",
                  "        sum += numbers[i] * (numbers.length + 1 - i);",
                  "    }",
                  "    const rest = (sum * 10) % 11;",
                  "    return rest === 10 ? 0 : rest;",
                  "}",
                  "let base;",
                  "do {",
                  "    base = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
                  "} while (new Set(base).size === 1);",
                  "base.push(digit(base));",
                  "base.push(digit(base));",
                  "const cpf = base.join('');",
                  "const letter = () => String.fromCharCode(65 + Math.floor(Math.random() * 26));",
                  "const number = () => Math.floor(Math.random() * 10);",
                  "pm.collectionVariables.set('customerDocument', cpf);",
                  "pm.collectionVariables.set('customerEmail', 'cliente.' + cpf + '@exemplo.com');",
                  "pm.collectionVariables.set('licensePlate', letter() + letter() + letter() + number() + letter() + number() + number());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('documento identificado como CPF', () => pm.expect(body.documentType).to.eql('CPF'));",
                  "pm.collectionVariables.set('customerId', body.id);"
                ]
              }
            }
          ]
        },
