      "description": "Lista de OS por prioridade e tempo médio de execução.",
      "item": [
        {
          "name": "Listar OS por prioridade",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/work-orders?customerId={{customerId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('OS do cliente listada', () => pm.expect(pm.response.json().items.map(o => o.code)).to.include(pm.collectionVariables.get('workOrderCode')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tempo médio de execução",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/work-orders/metrics/execution-time"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ao menos uma OS executada', () => pm.expect(body.executedCount).to.be.above(0));",
                  "pm.test('média por serviço', () => pm.expect(body.byService).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    }
